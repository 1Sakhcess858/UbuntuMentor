<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvWelcomeName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dashboard_welcome_default"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btnProfile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dashboard_profile" />

    <Button
        android:id="@+id/btnOpportunities"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dashboard_opportunities"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/btnSavedOpportunities"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="My Saved Opportunities"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/btnApplications"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="My Applications"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/btnSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_title"
        android:layout_marginTop="16dp" />

</LinearLayout>
